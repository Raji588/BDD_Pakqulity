# Base URL the browser context resolves relative paths against
BASE_URL=https://dev.pakquality.drinkpak.com/

# Run browsers headless (true/false) - "npm run login" always opens headed regardless
HEADLESS=true

# Milliseconds to slow down each browser action by (only meaningful when HEADLESS=false)
SLOW_MO=0

# Where the logged-in storage state (cookies/localStorage) is cached
STORAGE_STATE_PATH=tests/storageStates/user.json
